# PocketSmart AI environment configuration
# Copy this file to .env and fill in your values.

# Secret key for JWT signing (REQUIRED in production - use a long random string)
SECRET_KEY=change-me-to-a-long-random-string

# SQLite database URL
DATABASE_URL=sqlite:///./pocketsmart.db

# Google Gemini API key (OPTIONAL - the app runs in demo mode without it)
GEMINI_API_KEY=

# Gemini model name
GEMINI_MODEL=gemini-3.8-flash

# JWT access token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Contingency reserve percentage for every plan (0-100)
CONTINGENCY_PERCENT=10

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Maximum jewelry image upload size in MB
MAX_UPLOAD_SIZE_MB=5

# Directory for uploaded outfit images
UPLOAD_DIR=app/static/uploads
